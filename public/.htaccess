<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite static assets to index.html (prevents text/html MIME type errors for missing JS/chunks)
  RewriteCond %{REQUEST_URI} \.(js|mjs|cjs|wasm|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|webmanifest|json|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Route all other SPA navigation requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Correct MIME Types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Browser Caching Policy
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
